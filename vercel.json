{
  "version": 2,
  "routes": [
    {
      "src": "/api/evaluate",
      "dest": "/api/evaluate.js"
    },
    {
      "src": "/beginner",
      "dest": "/tests/beginner/latest.html"
    },
    {
      "src": "/intermediate",
      "dest": "/tests/intermediate/latest.html"
    },
    {
      "src": "/advanced",
      "dest": "/tests/advanced/latest.html"
    },
    {
      "src": "/tests/(.*)",
      "dest": "/tests/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
