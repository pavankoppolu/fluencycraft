{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/evaluate",
      "dest": "/api/evaluate.js"
    },
    {
      "src": "/tests/(.*)",
      "dest": "/tests/$1"
    },
    {
      "src": "/beginner",
      "dest": "/beginner.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
